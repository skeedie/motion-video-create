{
  "name": "lyric-studio",
  "productName": "Lyric Studio",
  "version": "0.1.1",
  "description": "Редактор lyric-роликов в стиле iOS-интерфейсов",
  "main": "main.js",
  "author": "melhor",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "onnxruntime-node": "^1.20.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.melhor.lyricstudio",
    "productName": "Lyric Studio",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "align.js", "app/**/*"],
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/onnxruntime-node/**"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "LyricStudio-Setup-${version}.exe" },
    "portable": { "artifactName": "LyricStudio-Portable-${version}.exe" }
  }
}
